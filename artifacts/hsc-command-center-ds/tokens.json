{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f4f8f7" },
      "foreground": { "$value": "#132d38" },
      "border": { "$value": "#d8e3e1" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#132d38" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#132d38" },
      "primary": {
        "$value": "#173b4d",
        "$description": "Deep navy for the clearest actions, links, and emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#dcece8" },
      "secondaryForeground": { "$value": "#183d42" },
      "muted": { "$value": "#eaf1ef" },
      "mutedForeground": { "$value": "#536a70" },
      "accent": { "$value": "#f5e7c5" },
      "accentForeground": { "$value": "#4c3813" },
      "destructive": { "$value": "#b23b43" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#cad9d7" },
      "ring": { "$value": "#237f79" },
      "chart1": { "$value": "#237f79" },
      "chart2": { "$value": "#e0ad4c" },
      "chart3": { "$value": "#35627a" },
      "chart4": { "$value": "#bd6652" },
      "chart5": { "$value": "#769b82" },
      "sidebar": { "$value": "#edf3f1" },
      "sidebarForeground": { "$value": "#304a54" },
      "sidebarBorder": { "$value": "#d8e3e1" },
      "sidebarPrimary": { "$value": "#173b4d" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#dcece8" },
      "sidebarAccentForeground": { "$value": "#183d42" },
      "sidebarRing": { "$value": "#237f79" }
    },
    "dark": {
      "background": { "$value": "#0d1d26" },
      "foreground": { "$value": "#eaf2ef" },
      "border": { "$value": "#2a414a" },
      "card": { "$value": "#132832" },
      "cardForeground": { "$value": "#eaf2ef" },
      "popover": { "$value": "#172f39" },
      "popoverForeground": { "$value": "#eaf2ef" },
      "primary": { "$value": "#57b8a9" },
      "primaryForeground": { "$value": "#082522" },
      "secondary": { "$value": "#203942" },
      "secondaryForeground": { "$value": "#d9e9e5" },
      "muted": { "$value": "#1b323b" },
      "mutedForeground": { "$value": "#a6bbb8" },
      "accent": { "$value": "#4b3e23" },
      "accentForeground": { "$value": "#f3dca1" },
      "destructive": { "$value": "#8f343e" },
      "destructiveForeground": { "$value": "#ffe9e9" },
      "input": { "$value": "#314a52" },
      "ring": { "$value": "#65c6b6" },
      "chart1": { "$value": "#65c6b6" },
      "chart2": { "$value": "#edc46e" },
      "chart3": { "$value": "#76a9c1" },
      "chart4": { "$value": "#e4866d" },
      "chart5": { "$value": "#9abb9c" },
      "sidebar": { "$value": "#10242d" },
      "sidebarForeground": { "$value": "#d8e6e2" },
      "sidebarBorder": { "$value": "#2a414a" },
      "sidebarPrimary": { "$value": "#57b8a9" },
      "sidebarPrimaryForeground": { "$value": "#082522" },
      "sidebarAccent": { "$value": "#203942" },
      "sidebarAccentForeground": { "$value": "#eaf2ef" },
      "sidebarRing": { "$value": "#65c6b6" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Readable, compact UI and body typeface for long study sessions."
      },
      "serif": { "$value": ["Source Serif 4", "Georgia", "serif"] },
      "mono": { "$value": ["Geist Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Soft, restrained base corner radius; component sizes derive from it."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
